# Shared secret that clients must present to the gateway.
# Generate one with: openssl rand -hex 32
PROXY_TOKEN=change-me

# Real OpenCode API key (oc_sk_...). It never leaves this host.
OPENCODE_API_KEY=oc_sk_replace_me

# Optional settings (defaults shown).
# HOST=0.0.0.0
# PORT=4000
# OPENCODE_SESSION=lan-gateway
# PROXY_UA=opencode-go-gateway
# CORS_ORIGIN=
# UPSTREAM_BASE=https://opencode.ai
# UPSTREAM_HEADERS_TIMEOUT_MS=60000
# MAX_BODY_BYTES=16777216

# Docker Compose only: interface on the HOST where port 4000 is published.
# The app never reads it. Leave it unset (or 127.0.0.1) for local-only access,
# or set your LAN IP to let other machines reach the gateway.
# BIND_ADDR=192.168.1.10
